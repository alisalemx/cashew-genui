{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cashew-genui",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor caps so a public link can't run up the AI bill.
  // Claude answers cost far more than Jev's, so they get the tighter cap.
  "ratelimits": [
    { "name": "ASK_LIMITER", "namespace_id": "2201", "simple": { "limit": 20, "period": 60 } },
    { "name": "CLAUDE_LIMITER", "namespace_id": "2202", "simple": { "limit": 5, "period": 60 } }
  ],
  // A daily budget for every Claude call, and each visitor's share of it
  // (worker/budget.ts). The per-minute caps above can't count a whole day.
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "Budget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "routes": [{ "pattern": "genui.alisalem.ca", "custom_domain": true }],
  // Jev runs through Cloudflare AI Gateway on this binding, paid from the
  // account's AI Gateway credits. AI bindings always reach Cloudflare, even in local dev.
  "ai": { "binding": "AI", "remote": true },
  "observability": { "enabled": true }
}
